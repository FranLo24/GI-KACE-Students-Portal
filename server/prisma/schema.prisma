generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Student {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fullName    String
  gender      String
  nationality String
  idType      String
  idTypeOther String?
  idNumber    String

  phoneNumber        String  @unique
  alternativePhone   String?
  emailAddress       String  @unique
  residentialAddress String
  cityTown           String

  highestEducation      String
  highestEducationOther String?
  fieldOfStudy          String

  employmentStatus  String
  organizationName  String?
  jobTitle          String?
  yearsOfExperience String?

  // courseTitle/courseCategory stay as the plain-text record of what was chosen at
  // registration; courseId is the live link used to resolve the invoice product.
  courseId            Int?
  course              Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseTitle         String
  courseCategory      String
  courseCategoryOther String?

  computerLiteracy String
  relevantSkills   String?

  emergencyName         String
  emergencyRelationship String
  emergencyPhone        String

  admissionStatus      String    @default("pending")
  admittedAt           DateTime?
  admissionSmsStatus   String?
  admissionEmailStatus String?

  // payment_reference of the academic invoice created when the student was
  // shortlisted — the reference the student pays against on the invoice site.
  paymentReference String?
  // Invoice status ("pending", "paid", …) as last returned by the invoice site's
  // POST /invoices/status — refreshed only when an admin runs Verify Status.
  paymentStatus    String?

  customFields Json?

  @@map("students")
}

model Admin {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String

  @@map("admins")
}

model CourseLevel {
  id        Int      @id @default(autoincrement())
  category  String   @unique
  level     String?
  updatedAt DateTime @updatedAt

  @@map("course_levels")
}

model FormSection {
  id          Int         @id @default(autoincrement())
  key         String      @unique
  title       String
  description String?
  order       Int         @default(0)
  enabled     Boolean     @default(true)
  fields      FormField[]
  updatedAt   DateTime    @updatedAt

  @@map("form_sections")
}

model FormField {
  id            Int         @id @default(autoincrement())
  sectionId     Int
  section       FormSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  key           String      @unique
  label         String
  type          String
  placeholder   String?
  required      Boolean     @default(false)
  options       Json?
  validation    Json?
  conditionalOn Json?
  order         Int         @default(0)
  enabled       Boolean     @default(true)
  isBuiltIn     Boolean     @default(false)
  updatedAt     DateTime    @updatedAt

  @@map("form_fields")
}

model FormSettings {
  id           Int      @id @default(1)
  heroImageUrl String?
  fontFamily   String   @default("'Trebuchet MS', 'Segoe UI', sans-serif")
  baseFontSize Int      @default(16)
  headingScale Float    @default(1)
  updatedAt    DateTime @updatedAt

  @@map("form_settings")
}

model Course {
  id           Int         @id @default(autoincrement())
  title        String
  category     String
  description  String?
  outcomes     String?
  spotlight    String?
  imageUrl     String?
  order        Int         @default(0)
  enabled      Boolean     @default(true)
  // Normalized invoice product name that created/matches this course. Set
  // only for courses that came from the invoice sync — lets re-syncs find
  // the right row even after an admin edits `title`, and lets the sync
  // distinguish courses it owns from ones an admin created by hand.
  syncKey      String?     @unique
  updatedAt    DateTime    @updatedAt
  locationFees CourseFee[]
  students     Student[]

  @@map("courses")
}

model CourseFee {
  id                Int      @id @default(autoincrement())
  courseId          Int
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  location          String
  fee               Float
  // The invoice site's product id for this exact course+branch pair — the value
  // POST /invoices/academic takes as course_id. One product there is always one
  // (name, branch) pair, e.g. DBC is 69d66af4… at Accra and 54b4e48a… at Sunyani,
  // which is why the id lives here and not on Course. Null means this location has
  // no invoice counterpart, so it can't be invoiced.
  invoiceProductId  String?  @unique
  // branch_code as the invoice site spells it ("SUN", "ACCRA"), kept so a synced
  // fee records which branch it came from without re-deriving it from location.
  invoiceBranchCode String?
  updatedAt         DateTime @updatedAt

  @@unique([courseId, location])
  @@map("course_fees")
}
