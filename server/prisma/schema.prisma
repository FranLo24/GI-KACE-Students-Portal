generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Student {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fullName    String
  gender      String
  nationality String
  idType      String
  idTypeOther String?
  idNumber    String

  phoneNumber        String  @unique
  alternativePhone   String?
  emailAddress       String  @unique
  residentialAddress String
  cityTown           String

  highestEducation      String
  highestEducationOther String?
  fieldOfStudy          String

  employmentStatus  String
  organizationName  String?
  jobTitle          String?
  yearsOfExperience String?

  courseTitle         String
  courseCategory      String
  courseCategoryOther String?

  computerLiteracy String
  relevantSkills   String?

  emergencyName         String
  emergencyRelationship String
  emergencyPhone        String

  admissionStatus      String    @default("pending")
  admittedAt           DateTime?
  admissionSmsStatus   String?
  admissionEmailStatus String?

  attendanceStatus       String    @default("not_marked")
  courseCompletionStatus String    @default("not_completed")
  completedAt            DateTime?

  customFields Json?

  @@map("students")
}

model Admin {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String

  @@map("admins")
}

model CourseLevel {
  id        Int      @id @default(autoincrement())
  category  String   @unique
  level     String?
  updatedAt DateTime @updatedAt

  @@map("course_levels")
}

model FormSection {
  id          Int         @id @default(autoincrement())
  key         String      @unique
  title       String
  description String?
  order       Int         @default(0)
  enabled     Boolean     @default(true)
  fields      FormField[]
  updatedAt   DateTime    @updatedAt

  @@map("form_sections")
}

model FormField {
  id            Int         @id @default(autoincrement())
  sectionId     Int
  section       FormSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  key           String      @unique
  label         String
  type          String
  placeholder   String?
  required      Boolean     @default(false)
  options       Json?
  validation    Json?
  conditionalOn Json?
  order         Int         @default(0)
  enabled       Boolean     @default(true)
  isBuiltIn     Boolean     @default(false)
  updatedAt     DateTime    @updatedAt

  @@map("form_fields")
}

model FormSettings {
  id           Int      @id @default(1)
  heroImageUrl String?
  fontFamily   String   @default("'Trebuchet MS', 'Segoe UI', sans-serif")
  baseFontSize Int      @default(16)
  headingScale Float    @default(1)
  updatedAt    DateTime @updatedAt

  @@map("form_settings")
}

model Course {
  id          Int      @id @default(autoincrement())
  title       String
  category    String
  description String?
  outcomes    String?
  spotlight   String?
  imageUrl    String?
  fee         Float?
  order       Int      @default(0)
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@map("courses")
}
